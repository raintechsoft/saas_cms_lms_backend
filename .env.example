# Prefer 127.0.0.1 over localhost on Windows.
# IMPORTANT: encode @ in password as %40
# Example: password saas_anwin@7736 -> saas_anwin%407736
DATABASE_URL="postgresql://saas_admin:saas_anwin%407736@127.0.0.1:5432/saas_cms_lms"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="8h"
# Keep stable across JWT rotations or existing provider credentials cannot be decrypted.
SETTINGS_ENCRYPTION_KEY="replace-with-a-separate-32-character-key"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Optional in development (codes/links print to console if unset).
# Required in production for OTP + password reset email delivery.
# Gmail: use an App Password (not your normal login password).
# Put real SMTP values only in .env (never commit secrets).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="your@gmail.com"
# SMTP_FROM_NAME="SaaS CMS LMS"
#
# Then verify: npm run mail:verify

# Optional — Google Sign-In
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# File storage (avatars / photos)
# local = ./uploads (default, good for development)
# s3 = AWS S3 or S3-compatible (R2, MinIO, Spaces)
STORAGE_DRIVER="local"
# S3_BUCKET="your-bucket"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# Optional for R2/MinIO:
# S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE=true
# Public URL base (CDN or bucket website). Recommended for S3.
# S3_PUBLIC_BASE_URL="https://cdn.yourdomain.com"
#
# Then verify: npm run storage:verify

SUPER_ADMIN_EMAIL="admin@saas-cms-lms.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
DEMO_ADMIN_EMAIL="admin@demo-school.local"
DEMO_ADMIN_PASSWORD="ChangeMe123!"
