model FeePaymentItem {
  id             String               @id @default(cuid())
  paymentId      String               @map("payment_id")
  assignmentId   String               @map("assignment_id")
  baseAmount     Decimal              @map("base_amount") @db.Decimal(12, 2)
  discountAmount Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  fineAmount     Decimal              @default(0) @map("fine_amount") @db.Decimal(12, 2)
  paidAmount     Decimal              @map("paid_amount") @db.Decimal(12, 2)
  payment        FeePayment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  assignment     StudentFeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@map("fee_payment_items")
}

model OnlineFeeOrder {
  id                String               @id @default(cuid())
  tenantId          String               @map("tenant_id")
  studentId         String               @map("student_id")
  academicSessionId String               @map("academic_session_id")
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR")
  status            OnlineFeeOrderStatus @default(PENDING)
  gateway           OnlineFeeGateway     @default(RAZORPAY)
  gatewayOrderId    String?              @map("gateway_order_id")
  gatewayPaymentId  String?              @map("gateway_payment_id")
  gatewaySignature  String?              @map("gateway_signature")
  feePaymentId      String?              @unique @map("fee_payment_id")
  items             Json
  metadata          Json?
  createdByUserId   String               @map("created_by_user_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession   AcademicSession      @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  feePayment        FeePayment?          @relation(fields: [feePaymentId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("OnlineFeeOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, gatewayOrderId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, studentId])
  @@index([gatewayPaymentId])
  @@map("online_fee_orders")
}

model TransportRoute {
  id            String                    @id @default(cuid())
  tenantId      String                    @map("tenant_id")
  name          String
  code          String?
  vehicleNumber String?                   @map("vehicle_number")
  driverName    String?                   @map("driver_name")
  driverPhone   String?                   @map("driver_phone")
  attendantName String?                   @map("attendant_name")
  color         String                    @default("#10B981")
  stops         Json?
  fareAmount    Decimal?                  @map("fare_amount") @db.Decimal(12, 2)
  isActive      Boolean                   @default(true) @map("is_active")
  notes         String?                   @db.Text
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students      Student[]
  assignments   TransportAssignmentLog[]
  vehicles      TransportVehicle[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("transport_routes")
}

enum TransportVehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model TransportVehicle {
  id              String                  @id @default(cuid())
  tenantId        String                  @map("tenant_id")
  registrationNo  String                  @map("registration_no")
  label           String?
  vehicleType     String                  @default("Bus") @map("vehicle_type")
  capacity        Int                     @default(40)
  status          TransportVehicleStatus  @default(ACTIVE)
  routeId         String?                 @map("route_id")
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route           TransportRoute?         @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, registrationNo])
  @@index([tenantId, status])
  @@index([tenantId, routeId])
  @@map("transport_vehicles")
}

enum TransportFeeType {
  ANNUAL
  MONTHLY
  QUARTERLY
}

enum TransportFeeCollectionMode {
  IN_ADVANCE
  IN_ARREARS
}

enum TransportWindowUnit {
  HOURS
  MINUTES
}

model TenantTransportSetting {
  tenantId                 String                     @id @map("tenant_id")
  moduleEnabled            Boolean                    @default(true) @map("module_enabled")
  pickupWindowValue        String                     @default("01:00") @map("pickup_window_value")
  pickupWindowUnit         TransportWindowUnit        @default(HOURS) @map("pickup_window_unit")
  dropWindowValue          String                     @default("01:30") @map("drop_window_value")
  dropWindowUnit           TransportWindowUnit        @default(HOURS) @map("drop_window_unit")
  allowParentTracking      Boolean                    @default(true) @map("allow_parent_tracking")
  feeType                  TransportFeeType           @default(MONTHLY) @map("fee_type")
  feeCollectionMode        TransportFeeCollectionMode @default(IN_ADVANCE) @map("fee_collection_mode")
  feeDueDay                Int                        @default(5) @map("fee_due_day")
  lateFeeAmount            Decimal                    @default(100) @map("late_fee_amount") @db.Decimal(12, 2)
  markAttendanceOnPickup   Boolean                    @default(true) @map("mark_attendance_on_pickup")
  markAttendanceOnDrop     Boolean                    @default(true) @map("mark_attendance_on_drop")
  notifyParentOnPickupDrop Boolean                    @default(true) @map("notify_parent_on_pickup_drop")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_transport_settings")
}

model TransportAssignmentLog {
  id              String          @id @default(cuid())
  tenantId        String          @map("tenant_id")
  studentId       String          @map("student_id")
  transportRouteId String?        @map("transport_route_id")
  stopName        String?         @map("stop_name")
  action          String
  note            String?
  assignedById    String?         @map("assigned_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transportRoute  TransportRoute? @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  assignedBy      User?           @relation("TransportAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, transportRouteId])
  @@map("transport_assignment_logs")
}

model HostelBlock {
