  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, hostelRoomId])
  @@map("hostel_allocation_logs")
}

enum LibraryLoanStatus {
  ISSUED
  RETURNED
  LOST
}

model LibraryCategory {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  parentId  String?          @map("parent_id")
  name      String
  isActive  Boolean          @default(true) @map("is_active")
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    LibraryCategory? @relation("LibraryCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LibraryCategory[] @relation("LibraryCategoryTree")
  books     LibraryBook[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, parentId])
