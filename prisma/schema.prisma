generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  SCHOOL
  COLLEGE_UNIVERSITY
  COACHING_CENTER
  INDIVIDUAL
}

enum ProductMode {
  CMS
  LMS
  BOTH
}

enum DistributionModel {
  UNIVERSE_AI
  RESELLER
  WHITE_LABEL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthVerificationPurpose {
  LOGIN_OTP
  PASSWORD_RESET
}

enum AttendanceType {
  DAY_WISE
  PERIOD_WISE
  BIOMETRIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  DISABLED
  ALUMNI
}

enum AdmissionType {
  REGULAR
  TRANSFER
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  WITHDRAWN
}

enum SubjectType {
  CORE
  ELECTIVE
}

enum SubjectDeliveryType {
  THEORY
  PRACTICAL
}

enum ScholarshipType {
  MERIT
  NEED
  GOVERNMENT
}

enum ScholarStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FeeFineType {
  NONE
  FIXED
  PERCENTAGE
  PER_DAY
  DATE_RANGE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum FeeInvoiceStatus {
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum FeeAssignmentStatus {
  ACTIVE
  WAIVED
  CANCELLED
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  ONLINE
  OTHER
}

enum PaymentStatus {
  COLLECTED
  REVERTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamResultType {
  GENERAL
  SCHOOL_GRADING
  COLLEGE_GRADING
  GPA
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PassStatus {
  PASS
  FAIL
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum StaffLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  NOT_GENERATED
  GENERATED
  PAID
}

enum AdjustmentType {
  EARNING
  DEDUCTION
}

enum DocumentTemplateType {
  ADMIT_CARD
  MARKSHEET
  CERTIFICATE
  ID_CARD
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  EVALUATED
  RESUBMIT_REQUESTED
  COMPLETED
}

enum ErpSettingCategory {
  NOTIFICATION
  SMS
  EMAIL
  WEBSITE
  LIVE_CLASS
  PAYMENT
}

enum OnlineFeeOrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum OnlineFeeGateway {
  RAZORPAY
}

enum CustomFieldTarget {
  STUDENT
  STAFF
  ADMISSION
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model Reseller {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  branding  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenants   Tenant[]
  users     User[]

  @@map("resellers")
}

model Tenant {
  id                     String                       @id @default(cuid())
  name                   String
  slug                   String                       @unique
  type                   TenantType
  productMode            ProductMode                  @map("product_mode")
  distributionModel      DistributionModel            @default(UNIVERSE_AI) @map("distribution_model")
  status                 TenantStatus                 @default(ACTIVE)
  branding               Json?
  resellerId             String?                      @map("reseller_id")
  reseller               Reseller?                    @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  users                  User[]
  roles                  Role[]
  userRoles              UserRole[]
  academicSessions       AcademicSession[]
  setting                TenantSetting?
  studentCategories      StudentCategory[]
  studentHouses          StudentHouse[]
  students               Student[]
  enrollments            StudentEnrollment[]
  academicClasses        AcademicClass[]
  sections               Section[]
  classSections          ClassSection[]
  subjects               Subject[]
  classSubjects          ClassSubject[]
  electiveCategories     ElectiveCategory[]
  studentElectives       StudentElectiveAssignment[]
  subjectGroups          SubjectGroup[]
  schoolScholars         SchoolScholar[]
  academicBulkLogs       AcademicBulkUpdateLog[]
  feeTypes               FeeType[]
  feeGroups              FeeGroup[]
  feeMasters             FeeMaster[]
  feeFineRanges          FeeFineRange[]
  feeDiscounts           FeeDiscount[]
  feeAssignments         StudentFeeAssignment[]
  feeInvoices            FeeInvoice[]
  feePayments            FeePayment[]
  feeReceiptBooks        FeeReceiptBook[]
  onlineFeeOrders        OnlineFeeOrder[]
  feeSetting             TenantFeeSetting?
  transportRoutes        TransportRoute[]
  hostelBlocks           HostelBlock[]
  hostelRooms            HostelRoom[]
  hostelBeds             HostelBed[]
  transportAssignmentLogs TransportAssignmentLog[]
  hostelAllocationLogs   HostelAllocationLog[]
  attendanceRecords      AttendanceRecord[]
  studentLeaves          StudentLeave[]
  attendancePoints       AttendancePoint[]
  examGrades             ExamGrade[]
  examGroups             ExamGroup[]
  exams                  Exam[]
  examSchedules          ExamSchedule[]
  examStudents           ExamStudent[]
  examMarks              ExamMark[]
  examAspects            ExamAspectField[]
  examAspectValues       ExamAspectValue[]
  markComponents         ExamMarkComponent[]
  markComponentScores    ExamMarkComponentScore[]
  examSubjectLinks       ExamSubjectLink[]
  examLinks              ExamLink[]
  departments            Department[]
  designations           Designation[]
  staffLeaveTypes        StaffLeaveType[]
  payParameters          PayParameter[]
  staffProfiles          StaffProfile[]
  staffAttendance        StaffAttendance[]
  staffLeaves            StaffLeave[]
  staffAdjustments       StaffAdjustment[]
  payrolls               Payroll[]
  payrollItems           PayrollItem[]
  teacherRatings         TeacherRating[]
  documentTemplates      DocumentTemplate[]
  generatedDocuments     GeneratedDocument[]
  auditLogs              AuditLog[]
  timetableEntries       TimetableEntry[]
  homework               Homework[]
  homeworkSubmissions    HomeworkSubmission[]
  erpSettings            ErpIntegrationSetting[]
  paymentMethods         TenantPaymentMethod[]
  moduleSettings         TenantModuleSetting[]
  languages              TenantLanguage[]
  customFields           CustomField[]
  systemFields           SystemFieldSetting[]
  shortcutKeys           ShortcutKeySetting[]
  studentProfileRights   StudentProfileRight[]
  holidays               Holiday[]
  studentDocumentFolders StudentDocumentFolder[]
  studentDocuments       StudentDocument[]
  configurationBackups   ConfigurationBackup[]
  studentGuardians       StudentGuardian[]
  disableReasons         DisableReason[]
  onlineAdmissions       OnlineAdmissionApplication[]
  notices                Notice[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]

  @@index([resellerId])
  @@map("tenants")
}

model User {
  id                       String                       @id @default(cuid())
  tenantId                 String?                      @map("tenant_id")
  resellerId               String?                      @map("reseller_id")
  email                    String
  passwordHash             String?                      @map("password_hash")
  googleSubjectId          String?                      @unique @map("google_subject_id")
  phone                    String?
  avatarUrl                String?                      @map("avatar_url")
  firstName                String                       @map("first_name")
  lastName                 String                       @map("last_name")
  status                   UserStatus                   @default(ACTIVE)
  firstLoginAt             DateTime?                    @map("first_login_at")
  lastLoginAt              DateTime?                    @map("last_login_at")
  lastLoginChannel         String?                      @map("last_login_channel")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  tenant                   Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reseller                 Reseller?                    @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  roles                    UserRole[]
  studentProfile           Student?
  taughtClassSections      ClassSection[]               @relation("ClassTeacher")
  subjectAssignments       ClassSubject[]               @relation("SubjectTeacher")
  feePaymentsCreated       FeePayment[]                 @relation("PaymentCreator")
  onlineFeeOrdersCreated   OnlineFeeOrder[]             @relation("OnlineFeeOrderCreator")
  transportAssignmentsMade TransportAssignmentLog[]     @relation("TransportAssignmentActor")
  hostelAllocationsMade    HostelAllocationLog[]        @relation("HostelAllocationActor")
  attendanceMarked         AttendanceRecord[]           @relation("AttendanceMarker")
  leavesReviewed           StudentLeave[]               @relation("LeaveReviewer")
  pointsAwarded            AttendancePoint[]            @relation("PointAwarder")
  staffProfile             StaffProfile?
  staffAttendanceMarked    StaffAttendance[]            @relation("StaffAttendanceMarker")
  staffLeavesReviewed      StaffLeave[]                 @relation("StaffLeaveReviewer")
  teacherRatingsGiven      TeacherRating[]              @relation("TeacherRatingAuthor")
  documentsGenerated       GeneratedDocument[]          @relation("DocumentGenerator")
  auditLogs                AuditLog[]
  authVerifications        AuthVerification[]
  timetableEntries         TimetableEntry[]             @relation("TimetableTeacher")
  homeworkCreated          Homework[]                   @relation("HomeworkCreator")
  homeworkEvaluated        HomeworkSubmission[]         @relation("HomeworkEvaluator")
  studentDocumentsUploaded StudentDocument[]            @relation("StudentDocumentUploader")
  studentDocumentsDeleted  StudentDocument[]            @relation("StudentDocumentDeleter")
  backupsCreated           ConfigurationBackup[]        @relation("BackupCreator")
  backupsRestored          ConfigurationBackup[]        @relation("BackupRestorer")
  guardianOf               StudentGuardian[]            @relation("GuardianUser")
  admissionsReviewed       OnlineAdmissionApplication[] @relation("AdmissionReviewer")
  noticesCreated           Notice[]                     @relation("NoticeAuthor")
  notifications            NotificationRead[]
  sentNotifications        Notification[]               @relation("NotificationAuthor")
  targetedNotifications    Notification[]               @relation("NotificationTarget")
  pushSubscriptions        PushSubscription[]
  academicBulkLogs         AcademicBulkUpdateLog[]      @relation("AcademicBulkActor")

  @@unique([tenantId, email])
  @@index([email])
  @@index([resellerId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?          @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  tenantId String? @map("tenant_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AcademicSession {
  id                String                       @id @default(cuid())
  tenantId          String                       @map("tenant_id")
  name              String
  startDate         DateTime                     @map("start_date") @db.Date
  endDate           DateTime                     @map("end_date") @db.Date
  isCurrent         Boolean                      @default(false) @map("is_current")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections     ClassSection[]
  enrollments       StudentEnrollment[]
  feeMasters        FeeMaster[]
  feeInvoices       FeeInvoice[]
  feePayments       FeePayment[]
  onlineFeeOrders   OnlineFeeOrder[]
  attendanceRecords AttendanceRecord[]
  studentLeaves     StudentLeave[]
  attendancePoints  AttendancePoint[]
  examGroups        ExamGroup[]
  payrolls          Payroll[]
  timetableEntries  TimetableEntry[]
  homework          Homework[]
  holidays          Holiday[]
  onlineAdmissions  OnlineAdmissionApplication[]
  notices           Notice[]
  schoolScholars    SchoolScholar[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
  @@map("academic_sessions")
}

model TenantSetting {
  id                      String         @id @default(cuid())
  tenantId                String         @unique @map("tenant_id")
  address                 String?        @db.Text
  phone                   String?
  email                   String?
  currency                String         @default("INR")
  timezone                String         @default("Asia/Kolkata")
  dateFormat              String         @default("dd-MM-yyyy") @map("date_format")
  attendanceType          AttendanceType @default(DAY_WISE) @map("attendance_type")
  autoAdmissionNumber     Boolean        @default(false) @map("auto_admission_number")
  admissionPrefix         String?        @map("admission_prefix")
  nextAdmissionNumber     Int            @default(1) @map("next_admission_number")
  autoStaffNumber         Boolean        @default(false) @map("auto_staff_number")
  staffPrefix             String?        @map("staff_prefix")
  nextStaffNumber         Int            @default(1) @map("next_staff_number")
  teacherRestricted       Boolean        @default(false) @map("teacher_restricted")
  examResultType          ExamResultType @default(GENERAL) @map("exam_result_type")
  onlineAdmission         Boolean        @default(false) @map("online_admission")
  liveClassAutoAttendance Boolean        @default(false) @map("live_class_auto_attendance")
  attendancePresentPoints Int            @default(2) @map("attendance_present_points")
  attendanceHalfDayPoints Int            @default(1) @map("attendance_half_day_points")
  attendanceLatePoints    Int            @default(-1) @map("attendance_late_points")
  portalInactiveReminderEnabled Boolean  @default(false) @map("portal_inactive_reminder_enabled")
  portalInactiveReminderSms     Boolean  @default(true) @map("portal_inactive_reminder_sms")
  portalInactiveReminderEmail   Boolean  @default(true) @map("portal_inactive_reminder_email")
  portalInactiveReminderDays    Int      @default(7) @map("portal_inactive_reminder_days")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model StudentCategory {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("student_categories")
}

model StudentHouse {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("student_houses")
}

model Student {
  id                 String                       @id @default(cuid())
  tenantId           String                       @map("tenant_id")
  userId             String?                      @unique @map("user_id")
  admissionNumber    String                       @map("admission_number")
  firstName          String                       @map("first_name")
  lastName           String?                      @map("last_name")
  gender             Gender?
  dateOfBirth        DateTime?                    @map("date_of_birth") @db.Date
  categoryId         String?                      @map("category_id")
  houseId            String?                      @map("house_id")
  religion           String?
  caste              String?
  mobile             String?
  email              String?
  admissionDate      DateTime                     @map("admission_date") @db.Date
  photoUrl           String?                      @map("photo_url")
  bloodGroup         String?                      @map("blood_group")
  height             Float?
  weight             Float?
  currentAddress     String?                      @map("current_address") @db.Text
  permanentAddress   String?                      @map("permanent_address") @db.Text
  fatherName         String?                      @map("father_name")
  fatherPhone        String?                      @map("father_phone")
  fatherEmail        String?                      @map("father_email")
  fatherOccupation   String?                      @map("father_occupation")
  motherName         String?                      @map("mother_name")
  motherPhone        String?                      @map("mother_phone")
  motherEmail        String?                      @map("mother_email")
  motherOccupation   String?                      @map("mother_occupation")
  guardianName       String?                      @map("guardian_name")
  guardianRelation   String?                      @map("guardian_relation")
  guardianPhone      String?                      @map("guardian_phone")
  guardianEmail      String?                      @map("guardian_email")
  guardianOccupation String?                      @map("guardian_occupation")
  nationality        String?
  admissionType      AdmissionType                @default(REGULAR) @map("admission_type")
  rteEnabled         Boolean                      @default(false) @map("rte_enabled")
  rteSchemeName      String?                      @map("rte_scheme_name")
  rteCertificateNo   String?                      @map("rte_certificate_no")
  transportOptIn     Boolean                      @default(false) @map("transport_opt_in")
  transportRoute     String?                      @map("transport_route")
  transportRouteId   String?                      @map("transport_route_id")
  transportStopName  String?                      @map("transport_stop_name")
  hostelOptIn        Boolean                      @default(false) @map("hostel_opt_in")
  hostelRoom         String?                      @map("hostel_room")
  hostelRoomId       String?                      @map("hostel_room_id")
  hostelBedId        String?                      @unique @map("hostel_bed_id")
  additionalNotes    String?                      @map("additional_notes") @db.Text
  status             StudentStatus                @default(ACTIVE)
  disabledReason     String?                      @map("disabled_reason")
  siblingGroupId     String?                      @map("sibling_group_id")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  category           StudentCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  house              StudentHouse?                @relation(fields: [houseId], references: [id], onDelete: SetNull)
  transportRouteRef  TransportRoute?              @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  hostelRoomRef      HostelRoom?                  @relation(fields: [hostelRoomId], references: [id], onDelete: SetNull)
  hostelBedRef       HostelBed?                   @relation(fields: [hostelBedId], references: [id], onDelete: SetNull)
  enrollments        StudentEnrollment[]
  feePayments        FeePayment[]
  feeInvoices        FeeInvoice[]
  onlineFeeOrders    OnlineFeeOrder[]
  generatedDocuments GeneratedDocument[]
  documents          StudentDocument[]
  guardians          StudentGuardian[]
  onlineAdmissions   OnlineAdmissionApplication[]
  scholarships       SchoolScholar[]
  transportAssignmentLogs TransportAssignmentLog[]
  hostelAllocationLogs    HostelAllocationLog[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, status])
  @@index([tenantId, firstName, lastName])
  @@index([tenantId, siblingGroupId])
  @@index([categoryId])
  @@index([houseId])
  @@index([transportRouteId])
  @@index([hostelRoomId])
  @@map("students")
}

model AcademicClass {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  name               String
  code               String?
  sortOrder          Int                @default(0) @map("sort_order")
  inTime             String?            @map("in_time")
  halfDayTime        String?            @map("half_day_time")
  outTime            String?            @map("out_time")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections      ClassSection[]
  electiveCategories ElectiveCategory[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("academic_classes")
}

model Section {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sections")
}

model ClassSection {
  id                String                       @id @default(cuid())
  tenantId          String                       @map("tenant_id")
  academicSessionId String                       @map("academic_session_id")
  classId           String                       @map("class_id")
  sectionId         String                       @map("section_id")
  classTeacherId    String?                      @map("class_teacher_id")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession              @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  academicClass     AcademicClass                @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section                      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classTeacher      User?                        @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments       StudentEnrollment[]
  subjects          ClassSubject[]
  subjectGroups     SubjectGroup[]
  feeMasters        FeeMaster[]
  attendanceRecords AttendanceRecord[]
  examSchedules     ExamSchedule[]
  timetableEntries  TimetableEntry[]
  homework          Homework[]
  onlineAdmissions  OnlineAdmissionApplication[]
  notices           Notice[]
  notifications     Notification[]

  @@unique([tenantId, academicSessionId, classId, sectionId])
  @@index([tenantId, academicSessionId])
  @@index([classTeacherId])
  @@map("class_sections")
}

model ElectiveCategory {
  id          String                      @id @default(cuid())
  tenantId    String                      @map("tenant_id")
  name        String
  description String?                     @db.Text
  classId     String?                     @map("class_id")
  maxSelect   Int                         @default(1) @map("max_select")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicClass AcademicClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjects    Subject[]
  assignments StudentElectiveAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, classId])
  @@map("elective_categories")
}

model Subject {
  id                 String                      @id @default(cuid())
  tenantId           String                      @map("tenant_id")
  name               String
  code               String?
  type               SubjectType                 @default(CORE)
  deliveryType       SubjectDeliveryType         @default(THEORY) @map("delivery_type")
  electiveCategoryId String?                     @map("elective_category_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  electiveCategory   ElectiveCategory?           @relation(fields: [electiveCategoryId], references: [id], onDelete: SetNull)
  classSubjects      ClassSubject[]
  studentElectives   StudentElectiveAssignment[]

  @@unique([tenantId, name])
