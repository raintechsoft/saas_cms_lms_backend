}

model LibraryMemberType {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  name             String
  color            String   @default("#10B981")
  maxBooks         Int      @default(5) @map("max_books")
  issuePeriodDays  Int      @default(14) @map("issue_period_days")
  maxRenewals      Int      @default(2) @map("max_renewals")
  finePerDay       Decimal  @default(5) @map("fine_per_day") @db.Decimal(12, 2)
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
  @@map("library_member_types")
}

enum LibraryFineType {
  PER_DAY
  FLAT
}

enum LibraryBarcodeType {
  CODE128
  CODE39
  EAN13
  QR
}

model TenantLibrarySetting {
  tenantId                    String             @id @map("tenant_id")
  moduleEnabled               Boolean            @default(true) @map("module_enabled")
  libraryName                 String             @default("School Central Library") @map("library_name")
  accessionPrefix             String             @default("LIB-2025-") @map("accession_prefix")
  defaultIssuePeriodDays      Int                @default(14) @map("default_issue_period_days")
  allowRenewals               Boolean            @default(true) @map("allow_renewals")
  maxBooksPerMember           Int                @default(5) @map("max_books_per_member")
  maxRenewalsPerBook          Int                @default(2) @map("max_renewals_per_book")
  reservationValidityDays     Int                @default(2) @map("reservation_validity_days")
  returnGracePeriodDays       Int                @default(1) @map("return_grace_period_days")
  fineType                    LibraryFineType    @default(PER_DAY) @map("fine_type")
  fineAmount                  Decimal            @default(5) @map("fine_amount") @db.Decimal(12, 2)
  maxFinePerBook              Decimal            @default(100) @map("max_fine_per_book") @db.Decimal(12, 2)
  processingFee               Decimal            @default(20) @map("processing_fee") @db.Decimal(12, 2)
  enableReservations          Boolean            @default(true) @map("enable_reservations")
  dueDateReminders            Boolean            @default(true) @map("due_date_reminders")
  notifyOnOverdue             Boolean            @default(true) @map("notify_on_overdue")
  allowFineExemptions         Boolean            @default(true) @map("allow_fine_exemptions")
  autoCalculateFine           Boolean            @default(true) @map("auto_calculate_fine")
  showAvailabilityToStudents  Boolean            @default(false) @map("show_availability_to_students")
  allowMemberSelfRegistration Boolean            @default(false) @map("allow_member_self_registration")
  barcodeType                 LibraryBarcodeType @default(CODE128) @map("barcode_type")
  barcodePrefix               String             @default("LIB") @map("barcode_prefix")
  barcodeStartingNumber       Int                @default(1001) @map("barcode_starting_number")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  tenant                      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_library_settings")
}

model LibraryBook {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  categoryId      String?          @map("category_id")
  title           String
  author          String?
  isbn            String?
  accessionNo     String?          @map("accession_no")
  publisher       String?
  publishedYear   Int?             @map("published_year")
  totalCopies     Int              @default(1) @map("total_copies")
  availableCopies Int              @default(1) @map("available_copies")
  location        String?
  isActive        Boolean          @default(true) @map("is_active")
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        LibraryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  loans           LibraryLoan[]

  @@unique([tenantId, accessionNo])
  @@index([tenantId, isActive])
  @@index([tenantId, title])
  @@map("library_books")
}

model LibraryLoan {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  bookId       String            @map("book_id")
  studentId    String            @map("student_id")
  issuedAt     DateTime          @default(now()) @map("issued_at")
  dueAt        DateTime          @map("due_at")
  returnedAt   DateTime?         @map("returned_at")
  status       LibraryLoanStatus @default(ISSUED)
  fineAmount   Decimal?          @map("fine_amount") @db.Decimal(12, 2)
  note         String?
  issuedById   String?           @map("issued_by_id")
  returnedById String?           @map("returned_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book         LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy     User?             @relation("LibraryLoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedBy   User?             @relation("LibraryLoanReturner", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, studentId, issuedAt])
  @@index([tenantId, bookId, status])
  @@map("library_loans")
}

enum InventoryMovementType {
  ADD
  ISSUE
  RETURN
  ADJUST
}

model InventoryCategory {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  name      String
  isActive  Boolean         @default(true) @map("is_active")
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("inventory_categories")
}

model InventoryItem {
  id           String              @id @default(cuid())
  tenantId     String              @map("tenant_id")
  categoryId   String?             @map("category_id")
  name         String
  sku          String?
  unit         String?             @default("pcs")
  quantity     Int                 @default(0)
  reorderLevel Int                 @default(0) @map("reorder_level")
  location     String?
  isActive     Boolean             @default(true) @map("is_active")
  notes        String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     InventoryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements    InventoryMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  itemId      String                @map("item_id")
  type        InventoryMovementType
  quantity    Int
  studentId   String?               @map("student_id")
  note        String?
  createdById String?               @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item        InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  student     Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, type, createdAt])
  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, studentId])
  @@map("inventory_movements")
}

enum QuestionBankScope {
  GLOBAL
  BY_CLASS
}

enum NegativeMarkingApplyTo {
  ALL
  MCQ_ONLY
}

enum QuestionDifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum OnlineExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OnlineQuestionType {
  MCQ
  SUBJECTIVE
}

enum OnlineAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model OnlineExam {
  id              String               @id @default(cuid())
  tenantId        String               @map("tenant_id")
  academicSessionId String?            @map("academic_session_id")
  classSectionId  String?              @map("class_section_id")
  title           String
  description     String?              @db.Text
  durationMinutes Int                  @default(60) @map("duration_minutes")
  maxAttempts     Int                  @default(1) @map("max_attempts")
  passMarks       Int                  @default(0) @map("pass_marks")
  status          OnlineExamStatus     @default(DRAFT)
  startsAt        DateTime?            @map("starts_at")
  endsAt          DateTime?            @map("ends_at")
  isActive        Boolean              @default(true) @map("is_active")
  createdById     String?              @map("created_by_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession?     @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  classSection    ClassSection?        @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("OnlineExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions       OnlineExamQuestion[]
  attempts        OnlineExamAttempt[]

  @@index([tenantId, status, isActive])
  @@index([tenantId, title])
  @@map("online_exams")
}

model OnlineExamQuestion {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  examId        String             @map("exam_id")
  type          OnlineQuestionType
  prompt        String             @db.Text
  options       Json?
  correctOption Int?               @map("correct_option")
  marks         Int                @default(1)
  sortOrder     Int                @default(0) @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam          OnlineExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       OnlineExamAnswer[]

  @@index([tenantId, examId, sortOrder])
  @@map("online_exam_questions")
}

model OnlineExamAttempt {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  examId      String              @map("exam_id")
  studentId   String              @map("student_id")
  attemptNo   Int                 @default(1) @map("attempt_no")
  status      OnlineAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime            @default(now()) @map("started_at")
  submittedAt DateTime?           @map("submitted_at")
  score       Decimal?            @db.Decimal(10, 2)
  maxScore    Decimal?            @map("max_score") @db.Decimal(10, 2)
  rank        Int?
  gradedById  String?             @map("graded_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        OnlineExam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy    User?               @relation("OnlineExamAttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  answers     OnlineExamAnswer[]

  @@unique([tenantId, examId, studentId, attemptNo])
  @@index([tenantId, examId, status])
  @@index([tenantId, studentId])
  @@map("online_exam_attempts")
}

model OnlineExamAnswer {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  attemptId     String             @map("attempt_id")
  questionId    String             @map("question_id")
  selectedOption Int?              @map("selected_option")
  textAnswer    String?            @map("text_answer") @db.Text
  marksAwarded  Decimal?           @map("marks_awarded") @db.Decimal(10, 2)
  isCorrect     Boolean?           @map("is_correct")
  gradedAt      DateTime?          @map("graded_at")
  gradedById    String?            @map("graded_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt       OnlineExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      OnlineExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy      User?              @relation("OnlineExamAnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([tenantId, questionId])
  @@map("online_exam_answers")
}

model FeeFineRange {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  feeMasterId String    @map("fee_master_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
