model HostelAllocationLog {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  studentId    String      @map("student_id")
  hostelRoomId String?     @map("hostel_room_id")
  hostelBedId  String?     @map("hostel_bed_id")
