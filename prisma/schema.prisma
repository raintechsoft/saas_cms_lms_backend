generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  SCHOOL
  COLLEGE_UNIVERSITY
  COACHING_CENTER
  INDIVIDUAL
}

enum ProductMode {
  CMS
  LMS
  BOTH
}

enum DistributionModel {
  UNIVERSE_AI
  RESELLER
  WHITE_LABEL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthVerificationPurpose {
  LOGIN_OTP
  PASSWORD_RESET
}

enum AttendanceType {
  DAY_WISE
  PERIOD_WISE
  BIOMETRIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  DISABLED
  ALUMNI
}

enum AdmissionType {
  REGULAR
  TRANSFER
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  WITHDRAWN
}

enum SubjectType {
  CORE
  ELECTIVE
}

enum SubjectDeliveryType {
  THEORY
  PRACTICAL
  BOTH
}

enum ScholarshipType {
  MERIT
  NEED
  GOVERNMENT
}

enum ScholarStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FeeFineType {
  NONE
  FIXED
  PERCENTAGE
  PER_DAY
  DATE_RANGE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum FeeInvoiceStatus {
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum FeeAssignmentStatus {
  ACTIVE
  WAIVED
  CANCELLED
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  ONLINE
  OTHER
}

enum PaymentStatus {
  COLLECTED
  REVERTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamResultType {
  GENERAL
  SCHOOL_GRADING
  COLLEGE_GRADING
  GPA
}

enum ExamResultDisplayType {
  SUBJECT_WISE
  OVERALL
}

enum OnlineExamViewMode {
  AFTER_SUBMISSION
  AFTER_PUBLISH
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PassStatus {
  PASS
  FAIL
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum StaffLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  NOT_GENERATED
  GENERATED
  PAID
}

enum AdjustmentType {
  EARNING
  DEDUCTION
}

enum DocumentTemplateType {
  ADMIT_CARD
  MARKSHEET
  CERTIFICATE
  ID_CARD
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PeriodNumberingMode {
  CONTINUOUS
  RESET_AFTER_BREAKS
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  EVALUATED
  RESUBMIT_REQUESTED
  COMPLETED
}

enum ErpSettingCategory {
  NOTIFICATION
  SMS
  EMAIL
  WEBSITE
  LIVE_CLASS
  PAYMENT
  WHATSAPP
}

enum OnlineFeeOrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum OnlineFeeGateway {
  RAZORPAY
}

enum CustomFieldTarget {
  STUDENT
  STAFF
  ADMISSION
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model Reseller {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  branding  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenants   Tenant[]
  users     User[]

  @@map("resellers")
}

model Tenant {
  id                     String                       @id @default(cuid())
  name                   String
  slug                   String                       @unique
  type                   TenantType
  productMode            ProductMode                  @map("product_mode")
  distributionModel      DistributionModel            @default(UNIVERSE_AI) @map("distribution_model")
  status                 TenantStatus                 @default(ACTIVE)
  branding               Json?
  resellerId             String?                      @map("reseller_id")
  reseller               Reseller?                    @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  users                  User[]
  roles                  Role[]
  userRoles              UserRole[]
  academicSessions       AcademicSession[]
  setting                TenantSetting?
  studentCategories      StudentCategory[]
  studentHouses          StudentHouse[]
  students               Student[]
  enrollments            StudentEnrollment[]
  academicClasses        AcademicClass[]
  sections               Section[]
  classSections          ClassSection[]
  subjects               Subject[]
  classSubjects          ClassSubject[]
  electiveCategories     ElectiveCategory[]
  studentElectives       StudentElectiveAssignment[]
  subjectGroups          SubjectGroup[]
  schoolScholars         SchoolScholar[]
  academicBulkLogs       AcademicBulkUpdateLog[]
  feeTypes               FeeType[]
  feeGroups              FeeGroup[]
  feeMasters             FeeMaster[]
  feeFineRanges          FeeFineRange[]
  feeDiscounts           FeeDiscount[]
  feeAssignments         StudentFeeAssignment[]
  feeInvoices            FeeInvoice[]
  feePayments            FeePayment[]
  feeReceiptBooks        FeeReceiptBook[]
  multiFeeBooks          MultiFeeBook[]
  multiFeeBookClasses    MultiFeeBookClass[]
  multiFeeBookHeads      MultiFeeBookHead[]
  onlineFeeOrders        OnlineFeeOrder[]
  feeSetting             TenantFeeSetting?
  questionBankSetting    TenantQuestionBankSetting?
  testSeriesSetting      TenantTestSeriesSetting?
  homeworkSetting        TenantHomeworkSetting?
  homeworkTypes          HomeworkType[]
  homeworkWorkflowStatuses HomeworkWorkflowStatus[]
  staffAttendanceSetting TenantStaffAttendanceSetting?
  payrollSetting         TenantPayrollSetting?
  studentAccessSetting   TenantStudentAccessSetting?
  staffWorkShifts        StaffWorkShift[]
  transportRoutes        TransportRoute[]
  hostelBlocks           HostelBlock[]
  hostelRooms            HostelRoom[]
  hostelBeds             HostelBed[]
  transportAssignmentLogs TransportAssignmentLog[]
  hostelAllocationLogs   HostelAllocationLog[]
  libraryCategories      LibraryCategory[]
  libraryBooks           LibraryBook[]
  libraryLoans           LibraryLoan[]
  librarySetting         TenantLibrarySetting?
  libraryMemberTypes     LibraryMemberType[]
  inventoryCategories    InventoryCategory[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  onlineExams            OnlineExam[]
  onlineExamQuestions    OnlineExamQuestion[]
  onlineExamAttempts     OnlineExamAttempt[]
  onlineExamAnswers      OnlineExamAnswer[]
  attendanceRecords      AttendanceRecord[]
  studentLeaves          StudentLeave[]
  attendancePoints       AttendancePoint[]
  examGrades             ExamGrade[]
  gradingScales          GradingScale[]
  gradingScaleGrades     GradingScaleGrade[]
  gradingScaleClasses    GradingScaleClass[]
  examGroups             ExamGroup[]
  exams                  Exam[]
  examSchedules          ExamSchedule[]
  examStudents           ExamStudent[]
  examMarks              ExamMark[]
  examAspects            ExamAspectField[]
  examAspectValues       ExamAspectValue[]
  markComponents         ExamMarkComponent[]
  markComponentScores    ExamMarkComponentScore[]
  examSubjectLinks       ExamSubjectLink[]
  examLinks              ExamLink[]
  departments            Department[]
  designations           Designation[]
  staffLeaveTypes        StaffLeaveType[]
  payParameters          PayParameter[]
  staffProfiles          StaffProfile[]
  staffAttendance        StaffAttendance[]
  staffLeaves            StaffLeave[]
  staffAdjustments       StaffAdjustment[]
  payrolls               Payroll[]
  payrollItems           PayrollItem[]
  teacherRatings         TeacherRating[]
  documentTemplates      DocumentTemplate[]
  generatedDocuments     GeneratedDocument[]
  auditLogs              AuditLog[]
  timetableEntries       TimetableEntry[]
  timetablePeriods       TimetablePeriod[]
  timetableTemplates     TimetableTemplate[]
  timetableTemplateClasses TimetableTemplateClass[]
  homework               Homework[]
  homeworkSubmissions    HomeworkSubmission[]
  erpSettings            ErpIntegrationSetting[]
  paymentMethods         TenantPaymentMethod[]
  moduleSettings         TenantModuleSetting[]
  languages              TenantLanguage[]
  customFields           CustomField[]
  systemFields           SystemFieldSetting[]
  shortcutKeys           ShortcutKeySetting[]
  studentProfileRights   StudentProfileRight[]
  holidays               Holiday[]
  holidayGroups          HolidayGroup[]
  holidaySetting         TenantHolidaySetting?
  transportSetting       TenantTransportSetting?
  transportVehicles      TransportVehicle[]
  studentDocumentFolders StudentDocumentFolder[]
  studentDocuments       StudentDocument[]
  configurationBackups   ConfigurationBackup[]
  systemBackups          SystemBackup[]
  backupSchedules        BackupSchedule[]
  backupSetting          TenantBackupSetting?
  backupLogs             BackupLog[]
  studentGuardians       StudentGuardian[]
  disableReasons         DisableReason[]
  onlineAdmissions       OnlineAdmissionApplication[]
  notices                Notice[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  mobilePushTokens       MobilePushToken[]
  websitePages           WebsitePage[]
  websiteMenus           WebsiteMenu[]
  websiteMedia           WebsiteMediaAsset[]
  websiteBanners         WebsiteBanner[]
  websiteSetting         TenantWebsiteSetting?
  smsTemplates           SmsTemplate[]
  smsDeliveryLogs        SmsDeliveryLog[]
  emailGateways          EmailGateway[]
  emailTemplates         EmailTemplate[]
  emailDeliveryLogs      EmailDeliveryLog[]
  whatsappTemplates      WhatsAppTemplate[]
  whatsappDeliveryLogs   WhatsAppDeliveryLog[]
  pushTopics             PushTopic[]
  pushDeliveryLogs       PushDeliveryLog[]
  notificationTriggers   NotificationTrigger[]
  notificationTriggerLogs NotificationTriggerLog[]
  messageNoticeTemplates MessageNoticeTemplate[]
  dataImportJobs         DataImportJob[]
  dataExportJobs         DataExportJob[]
  twoFactorSetting       TenantTwoFactorSetting?
  sessionLoginPolicy     TenantSessionLoginPolicy?
  userLoginSessions      UserLoginSession[]
  loginActivityLogs      LoginActivityLog[]
  questionTypeConfigs    QuestionTypeConfig[]
  difficultyLevelConfigs DifficultyLevelConfig[]
  questionCategories     QuestionCategory[]
  bankQuestions          Question[]
  testSeries             TestSeries[]
  testSeriesPapers       TestSeriesPaper[]
  testSeriesPaperQuestions TestSeriesPaperQuestion[]
  lessonPlanningSetting  TenantLessonPlanningSetting?
  lessonPlans            LessonPlan[]
  liveClassesSetting     TenantLiveClassesSetting?
  liveClasses            LiveClass[]
  ncertSetting           TenantNcertSetting?
  ncertResources         NcertResource[]
  academicCalendarSetting TenantAcademicCalendarSetting?
  academicEvents         AcademicEvent[]

  @@index([resellerId])
  @@map("tenants")
}

model User {
  id                       String                       @id @default(cuid())
  tenantId                 String?                      @map("tenant_id")
  resellerId               String?                      @map("reseller_id")
  email                    String
  passwordHash             String?                      @map("password_hash")
  googleSubjectId          String?                      @unique @map("google_subject_id")
  phone                    String?
  avatarUrl                String?                      @map("avatar_url")
  firstName                String                       @map("first_name")
  lastName                 String                       @map("last_name")
  status                   UserStatus                   @default(ACTIVE)
  firstLoginAt             DateTime?                    @map("first_login_at")
  lastLoginAt              DateTime?                    @map("last_login_at")
  lastLoginChannel         String?                      @map("last_login_channel")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  tenant                   Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reseller                 Reseller?                    @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  roles                    UserRole[]
  studentProfile           Student?
  taughtClassSections      ClassSection[]               @relation("ClassTeacher")
  subjectAssignments       ClassSubject[]               @relation("SubjectTeacher")
  feePaymentsCreated       FeePayment[]                 @relation("PaymentCreator")
  multiFeeBooksCreated     MultiFeeBook[]               @relation("MultiFeeBookCreator")
  onlineFeeOrdersCreated   OnlineFeeOrder[]             @relation("OnlineFeeOrderCreator")
  transportAssignmentsMade TransportAssignmentLog[]     @relation("TransportAssignmentActor")
  hostelAllocationsMade    HostelAllocationLog[]        @relation("HostelAllocationActor")
  libraryLoansIssued       LibraryLoan[]                @relation("LibraryLoanIssuer")
  libraryLoansReturned     LibraryLoan[]                @relation("LibraryLoanReturner")
  inventoryMovementsMade   InventoryMovement[]          @relation("InventoryMovementActor")
  onlineExamsCreated       OnlineExam[]                 @relation("OnlineExamCreator")
  onlineExamAttemptsGraded OnlineExamAttempt[]          @relation("OnlineExamAttemptGrader")
  onlineExamAnswersGraded  OnlineExamAnswer[]           @relation("OnlineExamAnswerGrader")
  attendanceMarked         AttendanceRecord[]           @relation("AttendanceMarker")
  leavesReviewed           StudentLeave[]               @relation("LeaveReviewer")
  pointsAwarded            AttendancePoint[]            @relation("PointAwarder")
  staffProfile             StaffProfile?
  staffAttendanceMarked    StaffAttendance[]            @relation("StaffAttendanceMarker")
  staffLeavesReviewed      StaffLeave[]                 @relation("StaffLeaveReviewer")
  teacherRatingsGiven      TeacherRating[]              @relation("TeacherRatingAuthor")
  documentsGenerated       GeneratedDocument[]          @relation("DocumentGenerator")
  auditLogs                AuditLog[]
  authVerifications        AuthVerification[]
  timetableEntries         TimetableEntry[]             @relation("TimetableTeacher")
  homeworkCreated          Homework[]                   @relation("HomeworkCreator")
  homeworkEvaluated        HomeworkSubmission[]         @relation("HomeworkEvaluator")
  studentDocumentsUploaded StudentDocument[]            @relation("StudentDocumentUploader")
  studentDocumentsDeleted  StudentDocument[]            @relation("StudentDocumentDeleter")
  backupsCreated           ConfigurationBackup[]        @relation("BackupCreator")
  backupsRestored          ConfigurationBackup[]        @relation("BackupRestorer")
  guardianOf               StudentGuardian[]            @relation("GuardianUser")
  admissionsReviewed       OnlineAdmissionApplication[] @relation("AdmissionReviewer")
  noticesCreated           Notice[]                     @relation("NoticeAuthor")
  notifications            NotificationRead[]
  sentNotifications        Notification[]               @relation("NotificationAuthor")
  targetedNotifications    Notification[]               @relation("NotificationTarget")
  pushSubscriptions        PushSubscription[]
  mobilePushTokens         MobilePushToken[]
  academicBulkLogs         AcademicBulkUpdateLog[]      @relation("AcademicBulkActor")
  websitePagesUpdated      WebsitePage[]                @relation("WebsitePageUpdater")
  websiteMediaUploaded     WebsiteMediaAsset[]          @relation("WebsiteMediaUploader")
  questionsCreated         Question[]                   @relation("QuestionCreatedBy")
  questionsReviewed        Question[]                   @relation("QuestionReviewedBy")
  testSeriesCreated        TestSeries[]                 @relation("TestSeriesCreator")
  lessonPlansCreated       LessonPlan[]                 @relation("LessonPlanCreator")
  liveClassesCreated       LiveClass[]                  @relation("LiveClassCreator")
  liveClassesHosted        LiveClass[]                  @relation("LiveClassHost")
  ncertResourcesCreated    NcertResource[]              @relation("NcertResourceCreator")
  academicEventsCreated    AcademicEvent[]              @relation("AcademicEventCreator")

  @@unique([tenantId, email])
  @@index([email])
  @@index([resellerId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?          @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  tenantId String? @map("tenant_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AcademicSession {
  id                String                       @id @default(cuid())
  tenantId          String                       @map("tenant_id")
  name              String
  startDate         DateTime                     @map("start_date") @db.Date
  endDate           DateTime                     @map("end_date") @db.Date
  isCurrent         Boolean                      @default(false) @map("is_current")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections     ClassSection[]
  enrollments       StudentEnrollment[]
  feeMasters        FeeMaster[]
  feeInvoices       FeeInvoice[]
  feePayments       FeePayment[]
  onlineFeeOrders   OnlineFeeOrder[]
  attendanceRecords AttendanceRecord[]
  studentLeaves     StudentLeave[]
  attendancePoints  AttendancePoint[]
  examGroups        ExamGroup[]
  payrolls          Payroll[]
  timetableEntries  TimetableEntry[]
  homework          Homework[]
  onlineExams       OnlineExam[]
  holidays          Holiday[]
  onlineAdmissions  OnlineAdmissionApplication[]
  notices           Notice[]
  schoolScholars    SchoolScholar[]
  multiFeeBooks     MultiFeeBook[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
  @@map("academic_sessions")
}

model TenantSetting {
  id                      String         @id @default(cuid())
  tenantId                String         @unique @map("tenant_id")
  address                 String?        @db.Text
  phone                   String?
  email                   String?
  currency                String         @default("INR")
  timezone                String         @default("Asia/Kolkata")
  dateFormat              String         @default("dd-MM-yyyy") @map("date_format")
  attendanceType          AttendanceType @default(DAY_WISE) @map("attendance_type")
  biometricAttendanceEnabled Boolean     @default(false) @map("biometric_attendance_enabled")
  autoAdmissionNumber     Boolean        @default(false) @map("auto_admission_number")
  admissionPrefix         String?        @map("admission_prefix")
  admissionNumberDigits   Int            @default(5) @map("admission_number_digits")
  nextAdmissionNumber     Int            @default(1) @map("next_admission_number")
  autoStaffNumber         Boolean        @default(false) @map("auto_staff_number")
  staffPrefix             String?        @map("staff_prefix")
  staffNumberDigits       Int            @default(4) @map("staff_number_digits")
  nextStaffNumber         Int            @default(1) @map("next_staff_number")
  teacherRestricted       Boolean        @default(false) @map("teacher_restricted")
  examResultType          ExamResultType @default(GENERAL) @map("exam_result_type")
  examResultDisplayType   ExamResultDisplayType @default(SUBJECT_WISE) @map("exam_result_display_type")
  onlineExamViewMode      OnlineExamViewMode @default(AFTER_SUBMISSION) @map("online_exam_view_mode")
  onlineAdmission         Boolean        @default(false) @map("online_admission")
  onlineAdmissionRequirePayment Boolean  @default(false) @map("online_admission_require_payment")
  onlineAdmissionFeeTypeId String?       @map("online_admission_fee_type_id")
  liveClassAutoAttendance Boolean        @default(false) @map("live_class_auto_attendance")
  attendancePresentPoints Int            @default(2) @map("attendance_present_points")
  attendanceHalfDayPoints Int            @default(1) @map("attendance_half_day_points")
  attendanceLatePoints    Int            @default(-1) @map("attendance_late_points")
  portalInactiveReminderEnabled Boolean  @default(false) @map("portal_inactive_reminder_enabled")
  portalInactiveReminderSms     Boolean  @default(true) @map("portal_inactive_reminder_sms")
  portalInactiveReminderEmail   Boolean  @default(true) @map("portal_inactive_reminder_email")
  portalInactiveReminderDays    Int      @default(7) @map("portal_inactive_reminder_days")
  workingDays             Weekday[]      @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY]) @map("working_days")
  defaultPeriodDuration   Int            @default(45) @map("default_period_duration")
  firstPeriodStartsAt     String         @default("08:00") @map("first_period_starts_at")
  lastPeriodEndsAt        String         @default("15:30") @map("last_period_ends_at")
  periodNumberingMode     PeriodNumberingMode @default(CONTINUOUS) @map("period_numbering_mode")
  allowPeriodOverlap      Boolean        @default(false) @map("allow_period_overlap")
  enableDoublePeriod      Boolean        @default(true) @map("enable_double_period")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model StudentCategory {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("student_categories")
}

model StudentHouse {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("student_houses")
}

model Student {
  id                 String                       @id @default(cuid())
  tenantId           String                       @map("tenant_id")
  userId             String?                      @unique @map("user_id")
  admissionNumber    String                       @map("admission_number")
  firstName          String                       @map("first_name")
  lastName           String?                      @map("last_name")
  gender             Gender?
  dateOfBirth        DateTime?                    @map("date_of_birth") @db.Date
  categoryId         String?                      @map("category_id")
  houseId            String?                      @map("house_id")
  religion           String?
  caste              String?
  mobile             String?
  email              String?
  admissionDate      DateTime                     @map("admission_date") @db.Date
  photoUrl           String?                      @map("photo_url")
  bloodGroup         String?                      @map("blood_group")
  height             Float?
  weight             Float?
  currentAddress     String?                      @map("current_address") @db.Text
  permanentAddress   String?                      @map("permanent_address") @db.Text
  fatherName         String?                      @map("father_name")
  fatherPhone        String?                      @map("father_phone")
  fatherEmail        String?                      @map("father_email")
  fatherOccupation   String?                      @map("father_occupation")
  motherName         String?                      @map("mother_name")
  motherPhone        String?                      @map("mother_phone")
  motherEmail        String?                      @map("mother_email")
  motherOccupation   String?                      @map("mother_occupation")
  guardianName       String?                      @map("guardian_name")
  guardianRelation   String?                      @map("guardian_relation")
  guardianPhone      String?                      @map("guardian_phone")
  guardianEmail      String?                      @map("guardian_email")
  guardianOccupation String?                      @map("guardian_occupation")
  nationality        String?
  admissionType      AdmissionType                @default(REGULAR) @map("admission_type")
  rteEnabled         Boolean                      @default(false) @map("rte_enabled")
  rteSchemeName      String?                      @map("rte_scheme_name")
  rteCertificateNo   String?                      @map("rte_certificate_no")
  transportOptIn     Boolean                      @default(false) @map("transport_opt_in")
  transportRoute     String?                      @map("transport_route")
  transportRouteId   String?                      @map("transport_route_id")
  transportStopName  String?                      @map("transport_stop_name")
  hostelOptIn        Boolean                      @default(false) @map("hostel_opt_in")
  hostelRoom         String?                      @map("hostel_room")
  hostelRoomId       String?                      @map("hostel_room_id")
  hostelBedId        String?                      @unique @map("hostel_bed_id")
  additionalNotes    String?                      @map("additional_notes") @db.Text
  status             StudentStatus                @default(ACTIVE)
  disabledReason     String?                      @map("disabled_reason")
