  tenantId              String    @unique @map("tenant_id")
  autoReminder          Boolean   @default(false) @map("auto_reminder")
  reminderDaysBefore    Int       @default(3) @map("reminder_days_before")
  reminderDaysAfter     Int       @default(1) @map("reminder_days_after")
  reminderEmailEnabled  Boolean   @default(true) @map("reminder_email_enabled")
  reminderSmsEnabled    Boolean   @default(true) @map("reminder_sms_enabled")
  reminderExecutionTime String    @default("09:00") @map("reminder_execution_time")
  reminderSkipWeekends  Boolean   @default(true) @map("reminder_skip_weekends")
  reminderMinBalance    Boolean   @default(true) @map("reminder_min_balance")
  reminderSteps         Json?     @map("reminder_steps")
  lastReminderRunAt     DateTime? @map("last_reminder_run_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_fee_settings")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  tenantId            String            @map("tenant_id")
  studentEnrollmentId String            @map("student_enrollment_id")
  academicSessionId   String            @map("academic_session_id")
  classSectionId      String            @map("class_section_id")
  attendanceDate      DateTime          @map("attendance_date") @db.Date
  periodKey           String            @default("DAY") @map("period_key")
  status              AttendanceStatus
  inTime              String?           @map("in_time")
  outTime             String?           @map("out_time")
  note                String?           @db.Text
  markedById          String            @map("marked_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicSession     AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classSection        ClassSection      @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  markedBy            User              @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, studentEnrollmentId, attendanceDate, periodKey])
  @@index([tenantId, classSectionId, attendanceDate])
  @@index([tenantId, academicSessionId, status])
  @@map("attendance_records")
}

model StudentLeave {
  id                  String            @id @default(cuid())
  tenantId            String            @map("tenant_id")
  studentEnrollmentId String            @map("student_enrollment_id")
  academicSessionId   String            @map("academic_session_id")
  fromDate            DateTime          @map("from_date") @db.Date
  toDate              DateTime          @map("to_date") @db.Date
  reason              String            @db.Text
  attachmentUrl       String?           @map("attachment_url") @db.Text
  status              LeaveStatus       @default(PENDING)
  reviewedById        String?           @map("reviewed_by_id")
  reviewedAt          DateTime?         @map("reviewed_at")
  reviewNote          String?           @map("review_note") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicSession     AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  reviewedBy          User?             @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, fromDate])
  @@index([studentEnrollmentId])
  @@map("student_leaves")
}

model AttendancePoint {
  id                  String            @id @default(cuid())
  tenantId            String            @map("tenant_id")
  studentEnrollmentId String            @map("student_enrollment_id")
  academicSessionId   String            @map("academic_session_id")
  pointDate           DateTime          @map("point_date") @db.Date
  points              Int
  note                String?           @db.Text
  awardedById         String            @map("awarded_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicSession     AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  awardedBy           User              @relation("PointAwarder", fields: [awardedById], references: [id], onDelete: Restrict)

  @@index([tenantId, academicSessionId, pointDate])
  @@index([studentEnrollmentId])
  @@map("attendance_points")
}

model ExamGrade {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  resultType  ExamResultType @map("result_type")
  name        String
  minPercent  Decimal        @map("min_percent") @db.Decimal(5, 2)
  maxPercent  Decimal        @map("max_percent") @db.Decimal(5, 2)
  gradePoint  Decimal?       @map("grade_point") @db.Decimal(5, 2)
  passStatus  PassStatus     @map("pass_status")
  description String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, resultType, name])
  @@index([tenantId, resultType, minPercent, maxPercent])
  @@map("exam_grades")
}

model ExamGroup {
  id                String          @id @default(cuid())
  tenantId          String          @map("tenant_id")
  academicSessionId String          @map("academic_session_id")
  name              String
  resultType        ExamResultType  @map("result_type")
  description       String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  exams             Exam[]

  @@unique([tenantId, academicSessionId, name])
  @@index([tenantId, academicSessionId])
  @@map("exam_groups")
}

model Exam {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  examGroupId String              @map("exam_group_id")
  name        String
  description String?             @db.Text
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  status      ExamStatus          @default(DRAFT)
  publishedAt DateTime?           @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examGroup   ExamGroup           @relation(fields: [examGroupId], references: [id], onDelete: Cascade)
  schedules   ExamSchedule[]
  students    ExamStudent[]
  aspects     ExamAspectField[]
  documents   GeneratedDocument[]

  @@unique([tenantId, examGroupId, name])
  @@index([tenantId, status, startDate])
  @@map("exams")
}

model ExamSchedule {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  examId         String              @map("exam_id")
  classSectionId String              @map("class_section_id")
  classSubjectId String              @map("class_subject_id")
  examDate       DateTime            @map("exam_date") @db.Date
  startTime      String              @map("start_time")
  endTime        String              @map("end_time")
  room           String?
  maximumMarks   Decimal             @map("maximum_marks") @db.Decimal(8, 2)
  minimumMarks   Decimal             @map("minimum_marks") @db.Decimal(8, 2)
  creditHours    Decimal?            @map("credit_hours") @db.Decimal(6, 2)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  classSection   ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  classSubject   ClassSubject        @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  marks          ExamMark[]
  components     ExamMarkComponent[]

  @@unique([tenantId, examId, classSectionId, classSubjectId])
  @@index([tenantId, examDate])
  @@map("exam_schedules")
}

model ExamStudent {
  id                  String            @id @default(cuid())
  tenantId            String            @map("tenant_id")
  examId              String            @map("exam_id")
  studentEnrollmentId String            @map("student_enrollment_id")
  rollNumber          String?           @map("roll_number")
  showOnPortal        Boolean           @default(true) @map("show_on_portal")
  createdAt           DateTime          @default(now()) @map("created_at")
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam                Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  marks               ExamMark[]
  aspectValues        ExamAspectValue[]

  @@unique([tenantId, examId, studentEnrollmentId])
  @@index([tenantId, examId])
  @@map("exam_students")
}

model ExamMark {
  id              String                   @id @default(cuid())
  tenantId        String                   @map("tenant_id")
  scheduleId      String                   @map("schedule_id")
  examStudentId   String                   @map("exam_student_id")
  marksObtained   Decimal                  @default(0) @map("marks_obtained") @db.Decimal(8, 2)
  isAbsent        Boolean                  @default(false) @map("is_absent")
  remarks         String?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule        ExamSchedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  examStudent     ExamStudent              @relation(fields: [examStudentId], references: [id], onDelete: Cascade)
  componentScores ExamMarkComponentScore[]

  @@unique([tenantId, scheduleId, examStudentId])
  @@index([tenantId, examStudentId])
  @@map("exam_marks")
}

model ExamMarkComponent {
  id           String                   @id @default(cuid())
  tenantId     String                   @map("tenant_id")
  scheduleId   String                   @map("schedule_id")
  name         String
  maximumMarks Decimal                  @map("maximum_marks") @db.Decimal(8, 2)
  sortOrder    Int                      @default(0) @map("sort_order")
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule     ExamSchedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scores       ExamMarkComponentScore[]

  @@unique([tenantId, scheduleId, name])
  @@map("exam_mark_components")
}

model ExamMarkComponentScore {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  examMarkId  String            @map("exam_mark_id")
  componentId String            @map("component_id")
  marks       Decimal           @db.Decimal(8, 2)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examMark    ExamMark          @relation(fields: [examMarkId], references: [id], onDelete: Cascade)
  component   ExamMarkComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examMarkId, componentId])
  @@map("exam_mark_component_scores")
}

model ExamAspectField {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  examId       String            @map("exam_id")
  name         String
  fieldType    String            @default("BEHAVIOR") @map("field_type")
  maximumValue Decimal           @map("maximum_value") @db.Decimal(8, 2)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  values       ExamAspectValue[]

  @@unique([tenantId, examId, name])
  @@map("exam_aspect_fields")
}

model ExamAspectValue {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  aspectFieldId String          @map("aspect_field_id")
  examStudentId String          @map("exam_student_id")
  value         Decimal         @db.Decimal(8, 2)
  remarks       String?
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aspectField   ExamAspectField @relation(fields: [aspectFieldId], references: [id], onDelete: Cascade)
  examStudent   ExamStudent     @relation(fields: [examStudentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, aspectFieldId, examStudentId])
  @@map("exam_aspect_values")
}

model ExamSubjectLink {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  subjectIds          Json     @map("subject_ids")
  mergeType           String   @default("MERGE") @map("merge_type")
  bifurcationColumns  Int      @default(2) @map("bifurcation_columns")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("exam_subject_links")
}

/// Persisted Link Exams bundle for school/college consolidated results.
/// Result is read against finalExamId (last linked exam) with all examIds merged.
model ExamLink {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  name        String
  resultType  ExamResultType @map("result_type")
  finalExamId String         @map("final_exam_id")
  examIds     Json           @map("exam_ids")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, finalExamId])
  @@map("exam_links")
}

model Department {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile[]

  @@unique([tenantId, name])
  @@map("departments")
}

model Designation {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile[]

  @@unique([tenantId, name])
  @@map("designations")
}

model StaffLeaveType {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  annualLimit Int?         @map("annual_limit")
  createdAt   DateTime     @default(now()) @map("created_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaves      StaffLeave[]

  @@unique([tenantId, name])
  @@map("staff_leave_types")
}

model PayParameter {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  type          AdjustmentType @default(EARNING)
  defaultAmount Decimal        @default(0) @map("default_amount") @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pay_parameters")
}

model StaffProfile {
  id                 String              @id @default(cuid())
  tenantId           String              @map("tenant_id")
  userId             String              @unique @map("user_id")
  employeeNumber     String              @map("employee_number")
  departmentId       String?             @map("department_id")
  designationId      String?             @map("designation_id")
  joiningDate        DateTime            @map("joining_date") @db.Date
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  phone              String?
  address            String?             @db.Text
  basicSalary        Decimal             @default(0) @map("basic_salary") @db.Decimal(12, 2)
  status             StaffStatus         @default(ACTIVE)
  disabledReason     String?             @map("disabled_reason")
  gender             String?
  maritalStatus      String?             @map("marital_status")
  emergencyContact   String?             @map("emergency_contact")
  epfNumber          String?             @map("epf_number")
  contractType       String?             @map("contract_type")
  workShift          String?             @map("work_shift")
  workLocation       String?             @map("work_location")
  leaveAllowance     Int?                @map("leave_allowance")
  absenceDeduction   Decimal?            @map("absence_deduction") @db.Decimal(12, 2)
  leavingDate        DateTime?           @map("leaving_date") @db.Date
  resignationLetter  String?             @map("resignation_letter") @db.Text
  bankAccountTitle   String?             @map("bank_account_title")
  bankAccountNumber  String?             @map("bank_account_number")
  bankName           String?             @map("bank_name")
  bankIfsc           String?             @map("bank_ifsc")
  bankBranch         String?             @map("bank_branch")
  permanentAddress   String?             @map("permanent_address") @db.Text
  photoUrl           String?             @map("photo_url") @db.Text
  documents          Json?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  attendance         StaffAttendance[]
  leaves             StaffLeave[]
  adjustments        StaffAdjustment[]
  payrolls           Payroll[]
  ratings            TeacherRating[]
  generatedDocuments GeneratedDocument[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@map("staff_profiles")
}

model StaffAttendance {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  staffId        String                @map("staff_id")
  attendanceDate DateTime              @map("attendance_date") @db.Date
  status         StaffAttendanceStatus
  inTime         String?               @map("in_time")
  outTime        String?               @map("out_time")
  note           String?               @db.Text
  markedById     String                @map("marked_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff          StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  markedBy       User                  @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, staffId, attendanceDate])
  @@index([tenantId, attendanceDate, status])
  @@map("staff_attendance")
}

model StaffLeave {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  staffId      String           @map("staff_id")
  leaveTypeId  String           @map("leave_type_id")
  fromDate     DateTime         @map("from_date") @db.Date
  toDate       DateTime         @map("to_date") @db.Date
  reason       String           @db.Text
  status       StaffLeaveStatus @default(PENDING)
  reviewedById String?          @map("reviewed_by_id")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewNote   String?          @map("review_note") @db.Text
  attachment   Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff        StaffProfile     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType    StaffLeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewedBy   User?            @relation("StaffLeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, fromDate])
  @@map("staff_leaves")
}

model StaffAdjustment {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  staffId     String         @map("staff_id")
  name        String
  type        AdjustmentType
  amount      Decimal        @db.Decimal(12, 2)
  isRecurring Boolean        @default(false) @map("is_recurring")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff       StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, isActive])
  @@map("staff_adjustments")
}

model Payroll {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  staffId             String          @map("staff_id")
  academicSessionId   String          @map("academic_session_id")
  payrollMonth        DateTime        @map("payroll_month") @db.Date
  basicSalary         Decimal         @map("basic_salary") @db.Decimal(12, 2)
  attendanceDeduction Decimal         @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  grossAmount         Decimal         @map("gross_amount") @db.Decimal(12, 2)
  netAmount           Decimal         @map("net_amount") @db.Decimal(12, 2)
  status              PayrollStatus   @default(GENERATED)
  paidAt              DateTime?       @map("paid_at")
  paymentMode         PaymentMode?    @map("payment_mode")
  note                String?         @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff               StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  academicSession     AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  items               PayrollItem[]

  @@unique([tenantId, staffId, payrollMonth])
  @@index([tenantId, payrollMonth, status])
  @@map("payrolls")
}

model PayrollItem {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  payrollId String         @map("payroll_id")
  name      String
  type      AdjustmentType
  amount    Decimal        @db.Decimal(12, 2)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payroll   Payroll        @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([tenantId, payrollId])
  @@map("payroll_items")
}

model TeacherRating {
  id         String       @id @default(cuid())
  tenantId   String       @map("tenant_id")
  staffId    String       @map("staff_id")
  ratedById  String       @map("rated_by_id")
  rating     Int
  comment    String?      @db.Text
  ratingDate DateTime     @map("rating_date") @db.Date
  createdAt  DateTime     @default(now()) @map("created_at")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  ratedBy    User         @relation("TeacherRatingAuthor", fields: [ratedById], references: [id], onDelete: Restrict)

  @@index([tenantId, staffId, ratingDate])
  @@map("teacher_ratings")
}

model DocumentTemplate {
  id            String               @id @default(cuid())
